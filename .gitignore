.env
.venv/
build/
dist/
*.egg-info/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.DS_Store

# A frozen release is added only after its offline validator reports GO.
releases/*
!releases/README.md

# Raw responses from external services are not distributed in this repository.
results/**/raw/
*.restricted.*

# Live-corpus pilot manifests contain source accessions and stay outside Git.
*.private.jsonl
private/

# Generated accession manifests are reviewed and published as release assets,
# not committed as oversized Git blobs.
corpus-accessions.tsv
corpus-accessions.tsv.gz
