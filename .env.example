# Optional endpoint for an authorized OmicsPlorer evaluation deployment.
OMICSPLORER_API_BASE=http://localhost:8000
# Legacy evaluator clients still read this equivalent variable.
GENOFINDER_API_BASE=http://localhost:8000

# Leave empty unless the operator has explicitly authorized authenticated evaluation.
GENOFINDER_BEARER_TOKEN=

# Repository-relative output locations.
EVAL_DATA_DIR=./data
EVAL_RESULTS_DIR=./results

EVAL_SEED=42
EVAL_LOG_LEVEL=INFO
